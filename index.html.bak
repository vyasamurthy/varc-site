<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>VARC — Verifiable AI Runtime Control | Agentic Security Intelligence</title>
<meta name="description" content="VARC intercepts AI agent actions before they execute — and now reasons about them. Verifiable Cognitive Layer: economic impact scoring, predictive GRO, chain-of-thought verdicts. CMMC L2 · EU AI Act · Google Cloud Marketplace."/>
<meta name="keywords" content="AI governance platform, AI runtime control, AI agent governance, agentic security, OWASP LLM 2025, CMMC AI governance, SOC 2 AI compliance, behavioral scoring AI, enterprise AI governance"/>
<meta property="og:title" content="VARC — 52 Enterprise Agent Environments. One Governance Layer."/>
<meta property="og:description" content="VARC intercepts AI agent actions before they execute — now with cognitive intelligence. Economic impact scoring, predictive GRO, 6-step reasoning verdicts. CMMC L2 · EU AI Act · Google Cloud Marketplace."/>
<meta property="og:image" content="https://varc.live/og-image.png"/>
<meta property="og:site_name" content="VARC"/>
<meta property="og:type" content="website"/>
<meta property="og:url" content="https://varc.live"/>
<meta name="robots" content="index, follow"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="VARC — Verifiable AI Runtime Control"/>
<meta name="twitter:description" content="52 enterprise agent environments. One governance layer. Runtime interception before the action executes."/>
<meta name="twitter:image" content="https://varc.live/og-image.png"/>
<link rel="canonical" href="https://varc.live"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
/* ── DESIGN TOKENS — matching existing varc.live palette ── */
:root {
  --bg:        #060d1a;
  --bg2:       #0a1628;
  --bg3:       #0e1f38;
  --card:      #0d1a30;
  --card2:     #091422;
  --border:    #1a2d48;
  --border2:   #243d5c;
  --teal:      #2563EB;
  --teal2:     #1D4ED8;
  --teal-dim:  rgba(37,99,235,.12);
  --teal-glow: rgba(37,99,235,.06);
  --blue:      #3B82F6;
  --blue-dim:  rgba(59,130,246,.12);
  --blue2:     #1D4ED8;
  --blue-glow: rgba(37,99,235,.06);
  --fg:        #e2eaf5;
  --fg2:       #8fa0b8;
  --fg3:       #506070;
  --green:     #22c55e;
  --green-dim: rgba(34,197,94,.12);
  --amber:     #f59e0b;
  --amber-dim: rgba(245,158,11,.12);
  --red:       #ef4444;
  --red-dim:   rgba(239,68,68,.12);
  --r:         6px;
  --r2:        12px;
  --font:      'Space Grotesk', sans-serif;
  --mono:      'JetBrains Mono', monospace;
  --shadow:    0 8px 48px rgba(0,0,0,.6);
}
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0 }
html { scroll-behavior:smooth }
body { background:var(--bg); color:var(--fg); font-family:var(--font); font-size:16px; line-height:1.6; overflow-x:hidden }
a { color:inherit; text-decoration:none }
img { max-width:100%; display:block }

/* ── TYPOGRAPHY ── */
h1 { font-size:clamp(40px,5.5vw,72px); font-weight:700; line-height:1.06; letter-spacing:-1.5px }
h2 { font-size:clamp(28px,3.5vw,46px); font-weight:700; line-height:1.1; letter-spacing:-.8px }
h3 { font-size:18px; font-weight:600; line-height:1.3 }
h4 { font-size:15px; font-weight:600 }

/* ── NAV ── */
#nav {
  position:fixed; top:0; left:0; right:0; z-index:200;
  height:60px; padding:0 5%;
  display:flex; align-items:center; justify-content:space-between;
  background:rgba(6,13,26,.95); backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
}
.nav-logo { font-family:var(--mono); font-size:16px; font-weight:600; letter-spacing:-.3px; display:flex; align-items:center; gap:8px }
.nav-logo-v { color:var(--blue); font-size:18px }
.nav-links { display:flex; gap:24px; font-size:13px; color:var(--fg2); font-weight:500 }
.nav-links a:hover { color:var(--fg) }
.nav-actions { display:flex; gap:8px }
.btn { display:inline-flex; align-items:center; gap:6px; padding:8px 18px; border-radius:var(--r); font-family:var(--font); font-size:13px; font-weight:600; cursor:pointer; border:none; transition:all .18s; white-space:nowrap }
.btn-outline { background:transparent; border:1px solid var(--border2); color:var(--fg2) }
.btn-outline:hover { border-color:var(--blue2); color:var(--fg) }
.btn-teal { background:var(--blue); color:var(--bg); font-weight:700 }
.btn-teal:hover { background:var(--blue2); transform:translateY(-1px) }
.btn-blue { background:var(--blue); color:#fff }
.btn-blue:hover { opacity:.9; transform:translateY(-1px) }
.btn-lg { padding:13px 28px; font-size:15px; border-radius:var(--r2) }

/* ── HERO ── */
#hero {
  min-height:100vh; padding:120px 5% 80px;
  display:flex; flex-direction:column; justify-content:center;
  position:relative; overflow:hidden;
}
.hero-noise {
  position:absolute; inset:0; pointer-events:none;
  background:
    radial-gradient(ellipse 70% 50% at 65% 15%, rgba(37,99,235,.07) 0%, transparent 65%),
    radial-gradient(ellipse 40% 30% at 10% 85%, rgba(26,111,255,.07) 0%, transparent 60%);
}
.hero-grid-lines {
  position:absolute; inset:0; pointer-events:none;
  background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);
  background-size:72px 72px; opacity:.15;
}
.hero-inner { position:relative; max-width:840px }
.hero-pill {
  display:inline-flex; align-items:center; gap:8px;
  padding:5px 14px; border-radius:20px;
  background:var(--blue-dim); border:1px solid rgba(37,99,235,.25);
  font-family:var(--mono); font-size:11px; font-weight:500;
  color:var(--blue); letter-spacing:.5px; text-transform:uppercase;
  margin-bottom:28px;
}
.hero-pill-dot { width:6px; height:6px; border-radius:50%; background:var(--blue); animation:blink 2s infinite }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }
.hero-h1 { margin-bottom:22px }
.hero-h1 .accent { color:var(--blue) }
.hero-sub { font-size:clamp(16px,1.8vw,19px); color:var(--fg2); max-width:580px; font-weight:400; margin-bottom:36px; line-height:1.7 }
.hero-cta { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:60px }
.hero-stats {
  display:grid; grid-template-columns:repeat(5,1fr);
  border:1px solid var(--border); border-radius:var(--r2); overflow:hidden;
  max-width:760px; background:var(--card2);
}
.hero-stat { padding:20px 18px; text-align:center; border-right:1px solid var(--border) }
.hero-stat:last-child { border-right:none }
.hs-n { font-family:var(--mono); font-size:24px; font-weight:600; color:var(--blue); letter-spacing:-1px; line-height:1 }
.hs-l { font-size:10px; color:var(--fg3); text-transform:uppercase; letter-spacing:.7px; margin-top:5px }

/* ── LIVE INTERCEPT PANEL (right side) ── */
.hero-panel {
  position:absolute; right:5%; top:50%; transform:translateY(-50%);
  width:360px; background:var(--card); border:1px solid var(--border2);
  border-radius:var(--r2); overflow:hidden; box-shadow:var(--shadow);
}
.hp-bar {
  padding:10px 14px; background:var(--card2); border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between;
  font-family:var(--mono); font-size:10px; color:var(--fg3); letter-spacing:.4px;
}
.hp-bar-dot { display:flex; align-items:center; gap:6px; font-weight:600; color:var(--blue) }
.hp-bar-dot::before { content:''; width:6px; height:6px; border-radius:50%; background:var(--blue); animation:blink 1.5s infinite }
.hp-body { padding:14px }
.hp-row {
  display:flex; justify-content:space-between; align-items:center;
  padding:8px 10px; border-radius:var(--r); background:rgba(255,255,255,.02);
  margin-bottom:6px; font-size:11px;
}
.hp-label { color:var(--fg3); font-family:var(--mono) }
.hp-val { font-family:var(--mono); font-size:10px }
.c-ok { color:var(--green) }
.c-warn { color:var(--amber) }
.c-bad { color:var(--red) }
.c-info { color:var(--blue) }
.hp-bev { margin:10px 0; padding:10px; background:var(--blue-glow); border:1px solid rgba(37,99,235,.12); border-radius:var(--r) }
.hp-bev-title { font-family:var(--mono); font-size:9px; color:var(--blue); font-weight:600; letter-spacing:.6px; text-transform:uppercase; margin-bottom:8px }
.dim { display:flex; align-items:center; gap:6px; margin-bottom:4px }
.dim-n { font-family:var(--mono); font-size:9px; color:var(--fg3); width:72px; flex-shrink:0 }
.dim-t { flex:1; height:2px; background:var(--border2); border-radius:1px; overflow:hidden }
.dim-f { height:100%; border-radius:1px }
.df-blue { background:var(--blue) }
.df-amber { background:var(--amber) }
.df-red { background:var(--red) }
.df-blue { background:var(--blue) }
.dim-s { font-family:var(--mono); font-size:9px; width:28px; text-align:right }
.hp-verdict {
  display:flex; align-items:center; justify-content:space-between;
  padding:9px 10px; border-radius:var(--r);
  background:var(--red-dim); border:1px solid rgba(239,68,68,.2); margin-top:10px;
}
.hp-verdict-label { font-family:var(--mono); font-size:11px; font-weight:700; color:var(--red); letter-spacing:.5px }
.hp-verdict-ms { font-family:var(--mono); font-size:10px; color:var(--fg3) }

/* ── SECTION BASE ── */
section { padding:96px 5% }
.s-label { font-family:var(--mono); font-size:11px; font-weight:600; color:var(--blue); letter-spacing:1.2px; text-transform:uppercase; margin-bottom:12px }
.s-sub { font-size:17px; color:var(--fg2); max-width:540px; font-weight:400; line-height:1.7; margin-bottom:52px }
.alt-bg { background:var(--bg2) }

/* ── IDC BAND ── */
#idc-band {
  background:var(--card2); border-top:1px solid var(--border); border-bottom:1px solid var(--border);
  padding:52px 5%; text-align:center;
}
.idc-inner { max-width:760px; margin:0 auto }
.idc-quote {
  font-size:clamp(18px,2.5vw,26px); font-weight:600; line-height:1.45;
  letter-spacing:-.3px; margin-bottom:14px;
}
.idc-quote .hl { color:var(--blue) }
.idc-source { font-family:var(--mono); font-size:11px; color:var(--fg3); letter-spacing:.4px }
.idc-badges { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin-top:20px }
.idc-badge {
  padding:5px 14px; border-radius:20px; font-family:var(--mono); font-size:10px;
  font-weight:600; border:1px solid var(--border2); color:var(--fg2); letter-spacing:.4px;
}
.idc-badge.active { border-color:rgba(37,99,235,.35); color:var(--blue); background:var(--blue-dim) }

/* ── OWASP NEW SECTION ── */
.owasp-intro {
  display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;
  padding:32px 36px; background:var(--card); border:1px solid var(--border2);
  border-radius:var(--r2); margin-bottom:36px;
}
.owasp-intro p { font-size:14px; color:var(--fg2); line-height:1.75 }
.owasp-intro strong { color:var(--fg) }
.owasp-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px }
.owasp-card {
  padding:22px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); transition:border-color .18s;
}
.owasp-card:hover { border-color:var(--border2) }
.owasp-card.new-class { border-color:rgba(37,99,235,.2) }
.oc-num { font-family:var(--mono); font-size:10px; color:var(--blue); font-weight:600; letter-spacing:.5px; margin-bottom:7px }
.oc-num.new-tag { color:var(--red) }
.oc-title { font-size:13px; font-weight:600; margin-bottom:6px; color:var(--fg) }
.oc-desc { font-size:12px; color:var(--fg2); line-height:1.65; margin-bottom:10px }
.oc-badge {
  display:inline-flex; padding:2px 8px; border-radius:3px;
  font-family:var(--mono); font-size:9px; font-weight:700; letter-spacing:.4px;
}
.badge-full { background:var(--green-dim); color:var(--green); border:1px solid rgba(34,197,94,.25) }
.badge-partial { background:var(--amber-dim); color:var(--amber); border:1px solid rgba(245,158,11,.25) }
.badge-excl { background:var(--blue-dim); color:var(--blue); border:1px solid rgba(37,99,235,.25) }

/* ── STRESS TEST METRICS ── */
.stress-row {
  display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
  background:var(--border); border:1px solid var(--border); border-radius:var(--r2);
  overflow:hidden; margin-bottom:52px;
}
.sm-cell { padding:22px 24px; background:var(--card2); text-align:center }
.sm-n { font-family:var(--mono); font-size:26px; font-weight:600; color:var(--blue); letter-spacing:-1px; line-height:1 }
.sm-l { font-size:10px; color:var(--fg3); text-transform:uppercase; letter-spacing:.7px; margin-top:5px }

/* ── SAGA FRAMEWORK ── */
.saga-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:var(--r2); overflow:hidden; margin-bottom:52px }
.saga-phase { padding:28px 24px; background:var(--card) }
.saga-letter { font-family:var(--mono); font-size:32px; font-weight:700; color:var(--blue); line-height:1; margin-bottom:10px }
.saga-name { font-size:12px; font-weight:600; color:var(--fg); text-transform:uppercase; letter-spacing:.8px; margin-bottom:8px }
.saga-desc { font-size:13px; color:var(--fg2); line-height:1.65 }

/* ── 5 ENGINES ── */
.engines-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px }
.engine-card {
  padding:24px 20px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); transition:border-color .18s;
}
.engine-card:hover { border-color:var(--border2) }
.engine-icon { font-family:var(--mono); font-size:20px; color:var(--blue); margin-bottom:10px }
.engine-name { font-size:13px; font-weight:700; color:var(--fg); margin-bottom:6px }
.engine-desc { font-size:12px; color:var(--fg2); line-height:1.65 }

/* ── GRO LEVELS ── */
.gro-table { display:flex; flex-direction:column; gap:8px; max-width:780px; margin-bottom:36px }
.gro-row {
  display:grid; grid-template-columns:130px 1fr 120px;
  gap:16px; align-items:center; padding:14px 18px;
  background:var(--card); border:1px solid var(--border); border-radius:var(--r);
}
.gro-code { font-family:var(--mono); font-size:11px; font-weight:600; letter-spacing:.3px }
.l0 { color:var(--fg3) } .l1 { color:#60a5fa } .l2 { color:var(--amber) }
.l3 { color:#fb923c } .l4 { color:var(--red) }
.gro-name { font-size:13px; font-weight:600; margin-bottom:2px }
.gro-desc { font-size:12px; color:var(--fg2) }
.gro-sla { font-family:var(--mono); font-size:11px; color:var(--fg3); text-align:right }

/* ── COVERAGE ── */
.coverage-header { display:flex; align-items:baseline; gap:20px; margin-bottom:32px }
.coverage-big { font-family:var(--mono); font-size:72px; font-weight:700; color:var(--blue); line-height:1; letter-spacing:-3px }
.coverage-sub { font-size:17px; color:var(--fg2) }
.coverage-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px }
.cov-card {
  padding:22px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); transition:border-color .18s;
}
.cov-card:hover { border-color:var(--border2) }
.cov-cat { font-family:var(--mono); font-size:10px; color:var(--blue); font-weight:600; letter-spacing:.6px; text-transform:uppercase; margin-bottom:6px }
.cov-title { font-size:14px; font-weight:600; margin-bottom:4px; color:var(--fg) }
.cov-count { font-family:var(--mono); font-size:11px; color:var(--fg3); margin-bottom:8px }
.cov-desc { font-size:12px; color:var(--fg2); line-height:1.65 }

/* ── COMPARISON TABLE ── */
.compare-wrap { overflow-x:auto; border:1px solid var(--border); border-radius:var(--r2) }
table { width:100%; border-collapse:collapse; font-size:13px }
thead th {
  padding:13px 16px; background:var(--card2); text-align:left;
  font-size:11px; font-weight:600; color:var(--fg2); letter-spacing:.3px;
  border-bottom:1px solid var(--border);
}
thead th.varc-h { color:var(--blue); background:var(--blue-glow) }
tbody tr { border-bottom:1px solid var(--border) }
tbody tr:last-child { border-bottom:none }
tbody tr:hover { background:rgba(255,255,255,.015) }
td { padding:11px 16px; color:var(--fg2); vertical-align:middle }
td:first-child { color:var(--fg); font-weight:500; font-size:12px }
td.varc-td { color:var(--blue); font-weight:600; background:var(--blue-glow) }
.tick { color:var(--blue) } .cross { color:var(--fg3) } .ptick { color:var(--amber); font-size:12px }

/* ── CERTIFICATIONS ── */
.cert-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:40px }
.cert-card {
  padding:26px; background:var(--card); border:1px solid var(--border); border-radius:var(--r2);
}
.cert-score { font-family:var(--mono); font-size:32px; font-weight:600; color:var(--blue); line-height:1; margin-bottom:5px }
.cert-name { font-size:14px; font-weight:700; margin-bottom:6px; color:var(--fg) }
.cert-desc { font-size:12px; color:var(--fg2); line-height:1.65 }
.cert-bar { height:3px; background:var(--border2); border-radius:2px; margin-top:14px; overflow:hidden }
.cert-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,var(--blue2),var(--blue)) }

/* ── INFRA BADGES ── */
.infra-row { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:28px }
.infra-card {
  padding:20px; background:var(--card); border:1px solid var(--border); border-radius:var(--r2);
}
.infra-title { font-size:13px; font-weight:700; color:var(--fg); margin-bottom:4px }
.infra-live {
  display:inline-flex; align-items:center; gap:5px;
  font-family:var(--mono); font-size:10px; color:var(--green); margin-bottom:8px;
}
.infra-live::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--green) }
.infra-desc { font-size:12px; color:var(--fg2); line-height:1.65 }

/* ── INDUSTRIES ── */
.industry-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px }
.ind-card {
  padding:26px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); transition:border-color .18s;
}
.ind-card:hover { border-color:var(--border2) }
.ind-title { font-size:15px; font-weight:700; margin-bottom:8px; color:var(--fg) }
.ind-desc { font-size:12px; color:var(--fg2); line-height:1.65; margin-bottom:14px }
.ind-tags { display:flex; flex-wrap:wrap; gap:5px }
.ind-tag {
  padding:2px 8px; border-radius:3px;
  font-family:var(--mono); font-size:9px; font-weight:600; letter-spacing:.3px;
  background:var(--blue-dim); color:var(--blue); border:1px solid rgba(37,99,235,.15);
}

/* ── OPSCENTER DEMO ── */
.demo-wrap {
  background:var(--card); border:1px solid var(--border2); border-radius:var(--r2);
  overflow:hidden; max-width:900px;
}
.demo-bar {
  padding:12px 18px; background:var(--card2); border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between;
  font-family:var(--mono); font-size:11px; color:var(--fg3);
}
.demo-url { color:var(--fg2) }
.demo-body { padding:20px }
.demo-stats { display:grid; grid-template-columns:repeat(5,1fr); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:var(--r); overflow:hidden; margin-bottom:16px }
.ds-cell { padding:14px; text-align:center; background:var(--card2) }
.ds-n { font-family:var(--mono); font-size:18px; font-weight:600; color:var(--blue) }
.ds-l { font-size:10px; color:var(--fg3); text-transform:uppercase; letter-spacing:.5px; margin-top:3px }
.demo-bars { display:grid; grid-template-columns:repeat(5,1fr); gap:8px }
.db-item { font-size:11px; color:var(--fg2) }
.db-label { margin-bottom:4px; color:var(--fg3); font-family:var(--mono); font-size:10px }
.db-bar { height:4px; background:var(--border2); border-radius:2px; overflow:hidden }
.db-fill { height:100%; background:var(--blue); border-radius:2px }
.demo-checks { display:flex; flex-direction:column; gap:6px; margin-top:16px }
.demo-check { font-size:12px; color:var(--fg2); display:flex; align-items:center; gap:8px }
.demo-check::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--green); flex-shrink:0 }

/* ── PRICING ── */
.pricing-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px }
.price-card {
  padding:32px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); position:relative;
}
.price-card.featured { border-color:var(--blue2); box-shadow:0 0 32px rgba(37,99,235,.08) }
.price-tag {
  position:absolute; top:-11px; left:50%; transform:translateX(-50%);
  padding:3px 14px; background:var(--blue); color:var(--bg);
  font-family:var(--mono); font-size:10px; font-weight:700; border-radius:10px;
  white-space:nowrap; letter-spacing:.4px;
}
.pt-tier { font-family:var(--mono); font-size:11px; font-weight:600; color:var(--blue); letter-spacing:.8px; text-transform:uppercase; margin-bottom:6px }
.pt-amount { font-size:40px; font-weight:700; letter-spacing:-1.5px; line-height:1; margin-bottom:3px }
.pt-period { font-size:12px; color:var(--fg3) }
.pt-tagline { font-size:13px; color:var(--fg2); margin:14px 0 20px; line-height:1.55 }
.pt-features { list-style:none; margin-bottom:28px }
.pt-features li {
  font-size:12px; color:var(--fg2); padding:6px 0;
  border-bottom:1px solid var(--border);
  display:flex; align-items:flex-start; gap:8px;
}
.pt-features li::before { content:'—'; color:var(--blue); flex-shrink:0; font-weight:700 }

/* ── BLOG ── */
.blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px }
.blog-card {
  padding:26px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); display:flex; flex-direction:column;
  transition:border-color .18s;
}
.blog-card:hover { border-color:var(--border2) }
.blog-cat { font-family:var(--mono); font-size:10px; color:var(--blue); font-weight:600; letter-spacing:.6px; text-transform:uppercase; margin-bottom:8px }
.blog-title { font-size:15px; font-weight:600; line-height:1.4; margin-bottom:8px; color:var(--fg) }
.blog-sub { font-size:12px; color:var(--fg2); line-height:1.65; flex:1; margin-bottom:16px }
.blog-meta { font-family:var(--mono); font-size:10px; color:var(--fg3); margin-bottom:12px }
.blog-link { font-size:12px; font-weight:600; color:var(--blue) }

/* ── CONTACT ── */
.contact-grid { display:grid; grid-template-columns:1fr 1fr; gap:52px; align-items:start }
.form-group { margin-bottom:14px }
label { display:block; font-size:12px; color:var(--fg2); margin-bottom:5px; font-weight:500; letter-spacing:.2px }
input, select, textarea {
  width:100%; padding:10px 13px;
  background:var(--card2); border:1px solid var(--border2);
  border-radius:var(--r); color:var(--fg); font-family:var(--font); font-size:13px;
  transition:border-color .18s;
}
input:focus, select:focus, textarea:focus { outline:none; border-color:var(--blue2) }
select option { background:var(--card2) }
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px }
.contact-info { display:flex; flex-direction:column; gap:16px }
.ci-card { padding:20px; background:var(--card); border:1px solid var(--border); border-radius:var(--r2) }
.ci-title { font-family:var(--mono); font-size:11px; font-weight:600; color:var(--blue); letter-spacing:.5px; text-transform:uppercase; margin-bottom:6px }
.ci-body { font-size:13px; color:var(--fg2); line-height:1.6 }
.ci-body a { color:var(--blue2) }

/* ── FOOTER ── */
footer { background:var(--card2); border-top:1px solid var(--border); padding:52px 5% 28px }
.footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:48px; margin-bottom:40px }
.footer-brand { font-family:var(--mono); font-size:20px; font-weight:600; letter-spacing:-.3px; margin-bottom:10px; display:flex; align-items:center; gap:6px }
.footer-brand .v { color:var(--blue) }
.footer-tagline { font-size:13px; color:var(--fg2); line-height:1.7; margin-bottom:18px }
.footer-certs { display:flex; flex-direction:column; gap:6px }
.fc-badge {
  display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:4px;
  font-family:var(--mono); font-size:10px; color:var(--fg3);
  border:1px solid var(--border); background:rgba(255,255,255,.02);
}
.fc-badge.live { color:var(--blue); border-color:rgba(37,99,235,.2); background:var(--blue-dim) }
.footer-col h4 { font-family:var(--mono); font-size:10px; font-weight:700; color:var(--fg); letter-spacing:.8px; text-transform:uppercase; margin-bottom:14px }
.footer-col a { display:block; font-size:13px; color:var(--fg3); margin-bottom:8px; transition:color .15s }
.footer-col a:hover { color:var(--blue) }
.footer-bottom {
  display:flex; justify-content:space-between; align-items:center;
  padding-top:24px; border-top:1px solid var(--border);
  font-size:12px; color:var(--fg3);
}
.footer-bottom .mono { font-family:var(--mono); font-size:10px }

/* ── UTILITIES ── */
.max-w { max-width:1200px; margin:0 auto }
.mt2 { margin-top:8px } .mt4 { margin-top:16px } .mt6 { margin-top:24px } .mt8 { margin-top:32px }
.mb4 { margin-bottom:16px } .mb6 { margin-bottom:24px } .mb8 { margin-bottom:32px }
.divider { height:1px; background:var(--border); margin:0 }

@media(max-width:1024px){
  .hero-panel { display:none }
  .engines-grid { grid-template-columns:repeat(2,1fr) }
  .coverage-grid { grid-template-columns:repeat(2,1fr) }
}
@media(max-width:768px){
  .hero-stats { grid-template-columns:repeat(3,1fr) }
  .owasp-grid,.saga-grid,.engines-grid,.cert-grid,.industry-grid,.pricing-grid,.blog-grid,.infra-row { grid-template-columns:1fr }
  .owasp-intro,.contact-grid,.footer-grid { grid-template-columns:1fr }
  .stress-row { grid-template-columns:repeat(2,1fr) }
  .gro-row { grid-template-columns:1fr }
  .nav-links { display:none }
}

/* ── VCL COGNITIVE LAYER ── */
.vcl-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:48px }
.vcl-cap {
  padding:22px; background:var(--card); border:1px solid var(--border);
  border-radius:var(--r2); transition:border-color .18s; position:relative;
}
.vcl-cap:hover { border-color:var(--border2) }
.vcl-sprint { font-family:var(--mono); font-size:9px; font-weight:700; color:var(--blue); letter-spacing:1px; text-transform:uppercase; margin-bottom:6px }
.vcl-cap-title { font-size:14px; font-weight:700; color:var(--fg); margin-bottom:6px }
.vcl-cap-desc { font-size:12px; color:var(--fg2); line-height:1.65 }
.vcl-badge { display:inline-flex; padding:2px 8px; border-radius:3px; font-family:var(--mono); font-size:9px; font-weight:700; letter-spacing:.4px; margin-top:10px; background:var(--blue-dim); color:var(--blue); border:1px solid rgba(59,130,246,.2) }
.vcl-output {
  background:var(--card); border:1px solid var(--border2); border-radius:var(--r2);
  overflow:hidden; margin-bottom:20px;
}
.vcl-output-bar {
  padding:10px 16px; background:var(--card2); border-bottom:1px solid var(--border);
  display:flex; align-items:center; justify-content:space-between;
  font-family:var(--mono); font-size:10px; color:var(--fg3);
}
.vcl-output-bar .agent { color:var(--fg2); font-weight:600 }
.vcl-output-body { padding:16px }
.vcl-metric { display:flex; align-items:baseline; gap:10px; margin-bottom:6px }
.vcl-metric-val { font-family:var(--mono); font-size:22px; font-weight:700; color:var(--blue); line-height:1 }
.vcl-metric-label { font-size:12px; color:var(--fg2) }
.vcl-chips { display:flex; gap:6px; flex-wrap:wrap; margin:10px 0 }
.vcl-chip { padding:2px 10px; border-radius:12px; font-family:var(--mono); font-size:10px; font-weight:600; border:1px solid; }
.vcl-chip-red { background:rgba(239,68,68,.1); color:var(--red); border-color:rgba(239,68,68,.25) }
.vcl-chip-amber { background:var(--amber-dim); color:var(--amber); border-color:rgba(245,158,11,.25) }
.vcl-chip-blue { background:var(--blue-dim); color:var(--blue); border-color:rgba(59,130,246,.25) }
.vcl-chip-green { background:var(--green-dim); color:var(--green); border-color:rgba(34,197,94,.25) }
.vcl-reasoning { font-size:12px; color:var(--fg2); line-height:1.7; border-left:2px solid rgba(59,130,246,.3); padding-left:12px; margin-top:10px; font-style:italic }
.vcl-cot { display:flex; flex-direction:column; gap:8px }
.vcl-cot-step { display:flex; gap:12px; align-items:flex-start; padding:10px 12px; background:rgba(255,255,255,.02); border-radius:var(--r); border:1px solid var(--border) }
.vcl-cot-step.sev-critical { border-color:rgba(239,68,68,.2); background:rgba(239,68,68,.04) }
.vcl-cot-step.sev-high { border-color:rgba(245,158,11,.15); background:rgba(245,158,11,.03) }
.vcl-step-num { width:24px; height:24px; border-radius:50%; background:var(--blue-dim); color:var(--blue); display:flex; align-items:center; justify-content:center; font-family:var(--mono); font-size:10px; font-weight:700; flex-shrink:0; margin-top:1px }
.vcl-step-phase { font-size:11px; font-weight:700; color:var(--fg); margin-bottom:3px }
.vcl-step-finding { font-size:11px; color:var(--fg2); line-height:1.5 }
.sev-tag { float:right; font-family:var(--mono); font-size:9px; font-weight:700; padding:1px 6px; border-radius:3px; text-transform:uppercase; letter-spacing:.5px }
.sev-tag.critical { background:rgba(239,68,68,.15); color:var(--red) }
.sev-tag.high { background:var(--amber-dim); color:var(--amber) }
.sev-tag.low { background:rgba(255,255,255,.05); color:var(--fg3) }
.vcl-synthesis { margin-top:12px; padding:12px 14px; background:var(--blue-glow); border:1px solid rgba(37,99,235,.15); border-radius:var(--r); font-size:12px; color:var(--fg2); line-height:1.65; font-style:italic }
.vcl-enforcement { margin-top:8px; padding:10px 14px; background:rgba(239,68,68,.05); border:1px solid rgba(239,68,68,.15); border-radius:var(--r); font-size:11px; color:var(--fg2); line-height:1.6 }
.vcl-enforcement strong { color:var(--red) }
.vcl-two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px }
.vcl-llm-row { display:flex; gap:8px; flex-wrap:wrap; margin:16px 0 }
.llm-badge { padding:5px 14px; border-radius:20px; font-family:var(--mono); font-size:10px; font-weight:600; border:1px solid var(--border2); color:var(--fg2) }
.llm-badge.active { border-color:rgba(37,99,235,.35); color:var(--blue); background:var(--blue-dim) }
@media(max-width:768px){ .vcl-grid,.vcl-two-col { grid-template-columns:1fr } }

/* ════════════════════════════════════════════════════════════
   VARC VISUAL OVERHAUL — ANIMATIONS v3
════════════════════════════════════════════════════════════ */

/* ── Canvas neural network ── */
#varc-canvas {
  position: fixed; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 0;
  opacity: .28;
}

body > *:not(#varc-canvas) { position: relative; z-index: 1; }

/* ── Scroll Reveal ── */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity .65s cubic-bezier(.4,0,.2,1),
              transform .65s cubic-bezier(.4,0,.2,1);
}
.reveal.visible { opacity: 1; transform: none; }

/* ── Keyframes ── */
@keyframes fade-up {
  from { opacity:0; transform:translateY(20px); }
  to   { opacity:1; transform:none; }
}
@keyframes slide-in-row {
  from { opacity:0; transform:translateX(-8px); }
  to   { opacity:1; transform:none; }
}
@keyframes glow-pulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(59,130,246,0); }
  50%      { box-shadow: 0 0 24px 4px rgba(59,130,246,.18); }
}
@keyframes cursor-blink {
  0%,49% { opacity:1; } 50%,100% { opacity:0; }
}
@keyframes gradient-rotate {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes hero-bg-drift {
  0%   { transform: scale(1) translate(0,0); }
  50%  { transform: scale(1.08) translate(-2%,1.5%); }
  100% { transform: scale(1) translate(0,0); }
}
@keyframes badge-glow {
  0%,100% { border-color: rgba(37,99,235,.25); }
  50%      { border-color: rgba(37,99,235,.6); box-shadow: 0 0 12px rgba(37,99,246,.2); }
}
@keyframes stream-row-in {
  from { opacity:0; transform:translateY(-6px) scaleY(.95); }
  to   { opacity:1; transform:none; }
}
@keyframes logo-glitch {
  0%,90%,100% { text-shadow: none; }
  91%  { text-shadow: -2px 0 rgba(239,68,68,.8), 2px 0 rgba(59,130,246,.8); transform:translateX(-1px); }
  93%  { text-shadow: 2px 0 rgba(239,68,68,.8), -2px 0 rgba(59,130,246,.8); transform:translateX(1px); }
  95%  { text-shadow: none; transform:none; }
}
@keyframes shimmer {
  from { background-position: -200% center; }
  to   { background-position: 200% center; }
}
@keyframes intercept-flash {
  0%   { background: rgba(239,68,68,.0); }
  30%  { background: rgba(239,68,68,.12); }
  100% { background: rgba(239,68,68,.0); }
}

/* ── Hero ── */
.hero-noise { animation: hero-bg-drift 18s ease-in-out infinite; }
.hero-h1 { animation: fade-up .9s ease both; }
.hero-sub { animation: fade-up .9s ease .15s both; }
.hero-cta { animation: fade-up .9s ease .28s both; }
.hero-stats { animation: fade-up .9s ease .42s both; }
.hero-pill { animation: badge-glow 3s ease-in-out infinite; }

/* ── Nav logo glitch ── */
.nav-logo-v { animation: logo-glitch 8s ease-in-out infinite; display:inline-block; }

/* ── Cards — hover glow + lift + 3D tilt ── */
.engine-card, .vcl-cap, .cert-card, .owasp-card, .cov-card, .ind-card, .blog-card, .price-card, .saga-phase {
  transition: transform .22s cubic-bezier(.34,1.56,.64,1),
              box-shadow .22s ease,
              border-color .22s ease !important;
  will-change: transform;
  transform-style: preserve-3d;
}
.engine-card:hover, .vcl-cap:hover, .cert-card:hover, .cov-card:hover {
  transform: translateY(-6px) scale(1.01) !important;
  box-shadow: 0 0 0 1px rgba(59,130,246,.35),
              0 0 32px rgba(59,130,246,.12),
              0 20px 48px rgba(0,0,0,.45) !important;
  border-color: rgba(59,130,246,.4) !important;
}
.owasp-card:hover {
  transform: translateY(-4px) !important;
  box-shadow: 0 0 0 1px rgba(59,130,246,.25), 0 12px 32px rgba(0,0,0,.4) !important;
}
.saga-phase:hover {
  border-color: rgba(59,130,246,.3) !important;
  box-shadow: 0 0 16px rgba(59,130,246,.08) inset !important;
}

/* ── Gradient border on VCL outputs ── */
.vcl-output {
  position: relative;
}
.vcl-output::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: calc(var(--r2) + 1px);
  background: linear-gradient(90deg, rgba(59,130,246,.4), rgba(0,245,255,.2), rgba(139,92,246,.3), rgba(59,130,246,.4));
  background-size: 200% auto;
  animation: gradient-rotate 4s linear infinite;
  z-index: -1;
  opacity: .6;
}

/* ── Animated gradient on featured price card ── */
.price-card.featured::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: calc(var(--r2) + 1px);
  background: linear-gradient(90deg, rgba(37,99,235,.6), rgba(59,130,246,.8), rgba(29,78,216,.6));
  background-size: 200% auto;
  animation: gradient-rotate 3s linear infinite;
  z-index: -1;
}

/* ── VCL capability card accent ── */
.vcl-cap {
  position: relative;
  overflow: hidden;
}
.vcl-cap::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(59,130,246,.04), transparent);
  animation: shimmer 3s ease-in-out infinite;
}

/* ── Live Terminal ── */
#hero-terminal { background: var(--card); }

.terminal-stream {
  height: 282px;
  overflow: hidden;
  padding: 8px 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
  position: relative;
}

.stream-row {
  display: grid;
  grid-template-columns: 76px 1fr 44px 26px 86px;
  gap: 6px;
  align-items: center;
  font-family: var(--mono);
  font-size: 10px;
  padding: 5px 14px;
  border-left: 2px solid transparent;
  animation: stream-row-in .28s ease both;
  flex-shrink: 0;
  cursor: default;
}
.stream-row:hover { background: rgba(255,255,255,.025); }
.stream-row.delivered { border-left-color: rgba(34,197,94,.35); }
.stream-row.blocked   { border-left-color: rgba(239,68,68,.45); background: rgba(239,68,68,.025); }
.stream-row.flagged   { border-left-color: rgba(245,158,11,.4); background: rgba(245,158,11,.02); }
.stream-row.vcl-cognitive {
  background: rgba(37,99,235,.06);
  border-left-color: rgba(37,99,235,.5);
  grid-template-columns: 1fr;
  color: var(--blue);
  font-size: 9px;
  padding: 4px 14px;
}

.sr-time   { color: var(--fg3); }
.sr-agent  { color: var(--fg2); overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.sr-bev    { color: var(--fg); text-align:right; }
.sr-gro    { color: var(--fg3); text-align:center; }
.sr-verdict { font-weight:700; text-align:right; }
.sr-verdict.delivered { color: var(--green); }
.sr-verdict.blocked   { color: var(--red); }
.sr-verdict.flagged   { color: var(--amber); }

.terminal-footer {
  padding: 7px 14px;
  background: var(--card2);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 8px;
}

.terminal-cursor {
  display: inline-block;
  width: 7px; height: 13px;
  background: var(--blue);
  border-radius: 1px;
  animation: cursor-blink .9s step-end infinite;
  flex-shrink: 0;
}

/* ── BEV bar fill animation ── */
.dim-f {
  width: 0% !important;
  transition: width 1.4s cubic-bezier(.4,0,.2,1) !important;
}
.dim-f.animated { width: var(--w) !important; }

/* ── GRO row hover ── */
.gro-row {
  transition: background .2s, border-color .2s !important;
  cursor: default;
}
.gro-row:hover {
  background: rgba(59,130,246,.05) !important;
  border-color: rgba(59,130,246,.2) !important;
}

/* ── Animated IDC band text ── */
.idc-quote { animation: fade-up .8s ease .1s both; }

/* ── OWASP stress row ── */
.sm-n {
  background: linear-gradient(90deg, var(--blue), #60a5fa, var(--blue));
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 3s ease infinite;
}

/* ── Coverage big number ── */
.coverage-big {
  background: linear-gradient(135deg, var(--blue), #60a5fa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
}

/* ── Section dividers with gradient ── */
section::before {
  content: '';
  display: block;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(59,130,246,.2), transparent);
  margin: 0 5%;
  position: absolute;
  top: 0; left: 0; right: 0;
}
section { position: relative; }

/* ── Stat number shimmer ── */
.hs-n {
  background: linear-gradient(90deg, #60a5fa, #93c5fd, var(--blue), #60a5fa);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 4s ease infinite;
}

/* ── Blog card image strip ── */
.blog-card {
  border-top: 2px solid var(--border);
  transition: border-color .2s !important;
}
.blog-card:hover { border-top-color: var(--blue) !important; }

/* ── Intercept flash on blocked stream row ── */
@keyframes blocked-pulse {
  0% { background: rgba(239,68,68,.025); }
  40% { background: rgba(239,68,68,.07); }
  100% { background: rgba(239,68,68,.025); }
}
.stream-row.blocked { animation: stream-row-in .28s ease both, blocked-pulse 2s ease .3s; }

/* ── Responsive ── */
@media (max-width:768px) {
  .terminal-stream { height: 200px; }
}
</style>
</head>
<body>
<canvas id="varc-canvas" aria-hidden="true"></canvas>

<!-- NAV -->
<nav id="nav">
  <a href="#" class="nav-logo"><span class="nav-logo-v">V</span> VARC</a>
  <div class="nav-links">
    <a href="#platform">Platform</a>
    <a href="#owasp">OWASP 2025</a>
    <a href="#coverage">Coverage</a>
    <a href="#simulate">Demo</a>
    <a href="#redteam">Red Team</a>
    <a href="#certifications">Certifications</a>
    <a href="#pricing">Pricing</a>
    <a href="#vcl">Intelligence</a>
    <a href="#blog">Blog</a>
    <a href="#contact">Contact</a>
  </div>
  <div class="nav-actions">
    <a href="https://console.cloud.google.com/marketplace/product/venturevertex-public/varc" target="_blank" class="btn btn-outline">Marketplace</a>
    <a href="https://varc-api-67840786835.us-central1.run.app" target="_blank" class="btn btn-teal">Live Demo</a>
  </div>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-noise"></div>
  <div class="hero-grid-lines"></div>
  <div class="hero-inner">
    <div class="hero-pill" style="animation-delay:.05s"><span class="hero-pill-dot"></span>IDC Validated · 42-Vector Red Team · Google Cloud Marketplace · api.varc.live</div>
